# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it is ignored by .gitignore.

# Local Express port. Leave unset on Vercel.
PORT=5000

# MongoDB connection string (Atlas or local).
# The database name is "equiporadb" and is set in code to match the client.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Canonical frontend origin used to verify Better Auth JWTs and fetch its JWKS.
# Use the deployed frontend HTTPS origin on Vercel, with no trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Stripe keys (server-side only — never put the secret key on the client)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Signing secret for POST /api/payments/webhook.
# Local development (forward Stripe events to the Express server):
#   1. stripe login
#   2. stripe listen --forward-to localhost:5000/api/payments/webhook
#   3. copy the printed whsec_... value here and restart the API
# Use the signing secret printed by the active listener.
# On Vercel, use the signing secret of the hosted endpoint in the matching Stripe mode.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Exact frontend origin allowed by CORS and used for Checkout return links.
CLIENT_URL=http://localhost:3000

# ImgBB API key used by POST /api/uploads/image (server-side only)
IMGBB_API_KEY=your_imgbb_api_key_here
