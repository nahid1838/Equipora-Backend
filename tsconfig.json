{
  "compilerOptions": {
    /* File layout: source code in src/, compiled output in dist/ */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment: modern Node.js with ES modules
       ("type": "module" in package.json must stay in sync with this) */
    "module": "nodenext",
    "target": "esnext",
    // Vercel's TypeScript runner extends this config from a temporary directory.
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "esModuleInterop": true,

    /* Output */
    "sourceMap": true,

    /* Type checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Module behaviour */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
